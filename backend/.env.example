# Resy credentials - required for booking
RESY_EMAIL=your@email.com
RESY_PASSWORD=yourpassword

# Resy API key (public key - default works for most cases)
RESY_API_KEY=VbWk7s3L4KiK5fzlO7JD3Q5EYolJI7n5

# How often (in seconds) to poll Resy for available slots
POLL_INTERVAL_SECONDS=60

# Database — use SQLite locally, Postgres on Render (set automatically via render.yaml)
DATABASE_URL=sqlite:///./resy_booker.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# ALLOWED_ORIGINS=https://your-app.vercel.app
